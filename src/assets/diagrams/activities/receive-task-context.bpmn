  <bpmn:process id="PaymentProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order Placed">
      <bpmn:outgoing>Flow_1gaqt40</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="ReceiveTask_1" name="Wait for Payment">
      <bpmn:incoming>Flow_1gaqt40</bpmn:incoming>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Ship Order">
      <bpmn:outgoing>Flow_1wytfih</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Order Complete">
      <bpmn:incoming>Flow_1wytfih</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ReceiveTask_1" targetRef="ServiceTask_1" />
    <bpmn:sequenceFlow id="Flow_1gaqt40" sourceRef="StartEvent_1" targetRef="ReceiveTask_1" />
    <bpmn:sequenceFlow id="Flow_1wytfih" sourceRef="ServiceTask_1" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_7">
